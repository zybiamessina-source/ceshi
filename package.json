{
  "name": "douyin-radar-local",
  "version": "1.1.0",
  "description": "本地抖音爆款采集与文案识别客户端",
  "main": "src/main.js",
  "author": "Local User",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "set ELECTRON_RUN_AS_NODE=1&& electron --test test/parser.test.js test/api.test.js test/store.test.js",
    "pack": "electron-builder --win portable --x64",
    "installer": "electron-builder --win nsis --x64",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.douyin.radar",
    "productName": "抖音爆款雷达",
    "artifactName": "抖音爆款雷达-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "抖音爆款雷达-${version}-便携版.exe"
    },
    "nsis": {
      "artifactName": "抖音爆款雷达-${version}-安装版.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "抖音爆款雷达",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
